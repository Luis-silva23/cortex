{
  "name": "@ln-system/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "db:inventory": "tsx scripts/db-inventory.ts",
    "db:docs": "tsx scripts/db-docs.ts",
    "db:replay-check": "tsx scripts/db-replay-check.ts",
    "db:role-split-check": "tsx scripts/db-role-split-check.ts",
    "db:provision-context": "tsx scripts/provision-rls-context.ts",
    "password:bench": "tsx scripts/password-bench.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "help:seed": "tsx scripts/seed-help-articles.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:tools": "tsx scripts/demo-tools.ts",
    "secrets:encrypt": "tsx scripts/encrypt-secrets.ts",
    "backup:verify": "tsx scripts/verify-backup-restore.ts",
    "backup:anonymize": "tsx scripts/anonymize-restored.ts",
    "backup:drill": "tsx scripts/restore-drill.ts",
    "test:integration:prepare": "tsx scripts/prepare-test-db.ts",
    "pretest:integration": "npm run test:integration:prepare",
    "test:integration": "jest --config test/integration/jest.integration.config.js --runInBand --forceExit"
  },
  "dependencies": {
    "@ln-system/database": "*",
    "@ln-system/shared": "*",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "rate-limiter-flexible": "^3.0.0",
    "dotenv": "^16.3.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "ioredis": "^5.3.2",
    "bullmq": "^5.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/compression": "^1.7.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}
