{
  // Cloudflare Workers (OpenNext) do Super Admin. NADA daqui é usado pelo build normal (Docker/next start) e nenhuma implantação foi feita:
  // ver docs/CORTEX/CLOUDFLARE.md. O Worker precisa se chamar exatamente como no painel (Workers Builds recusa nome divergente).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex-super-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cortex-super-admin" }]
}
