# Proxy reverso para operar ATRÁS DA CLOUDFLARE (plano Free): docker-compose.cloudflare.yml monta este arquivo no lugar de deploy/Caddyfile.
#
# O que faz de diferente do Caddyfile de homologação:
#   1. TLS de ORIGEM com o certificado da Cloudflare (Origin CA, gratuito) em vez do Let's Encrypt: o Caddy não depende de a Cloudflare
#      repassar o desafio ACME. Modo SSL/TLS da Cloudflare: "Full (strict)".
#   2. IP REAL DO CLIENTE: só confia em cabeçalhos de IPs da Cloudflare e lê CF-Connecting-IP. Sem isto, a API enxergaria sempre o IP de uma
#      borda da Cloudflare e o limitador de requisições/bloqueio por tentativa passaria a valer para MILHARES de clientes juntos.
#      A API continua com TRUST_PROXY=1 (um salto: este Caddy), que agora entrega o IP verdadeiro em X-Forwarded-For.
#   3. ORIGEM PROTEGIDA: quem não vier de um IP da Cloudflare recebe 403 (defesa em profundidade; a barreira principal é o grupo de
#      segurança da nuvem, que só libera 80/443 para estes mesmos intervalos).
#
# Lista oficial de IPs da Cloudflare, copiada em 2026-10-19 de https://www.cloudflare.com/ips-v4 e https://www.cloudflare.com/ips-v6.
# ELA MUDA DE TEMPOS EM TEMPOS: reconfira essas duas páginas a cada 3 meses (ou antes de um incidente de acesso) e atualize AQUI e no grupo
# de segurança da nuvem. Certificado e chave da origem ficam FORA do repositório (ORIGIN_CERT_DIR no .env): origin.pem e origin.key.
#
# NÃO VALIDADO nesta máquina (sem Docker/Caddy): rode `docker compose ... config` e `docker exec ln-system-proxy caddy validate --config /etc/caddy/Caddyfile`
# no servidor antes de apontar o DNS.
#
#   https://api.<DOMINIO>    → API            https://admin.<DOMINIO>   → Admin Web
#   https://super.<DOMINIO>  → Super Admin    https://balcao.<DOMINIO>  → Balcão
# PostgreSQL e Redis NUNCA são alcançáveis por este proxy.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(cloudflare) {
	# certificado de origem da Cloudflare (curinga *.<DOMINIO> + <DOMINIO>), montado de ORIGIN_CERT_DIR
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	@fora_da_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @fora_da_cloudflare "Acesso direto à origem não permitido" 403

	encode gzip
	# HSTS: o navegador/aplicativo nunca mais tenta HTTP neste domínio.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

api.{$STAGING_DOMAIN} {
	import cloudflare
	reverse_proxy api:3001 {
		health_uri /api/health/live
		health_interval 15s
	}
}

admin.{$STAGING_DOMAIN} {
	import cloudflare
	reverse_proxy admin-web:3002
}

super.{$STAGING_DOMAIN} {
	import cloudflare
	reverse_proxy super-admin:3000
}

balcao.{$STAGING_DOMAIN} {
	import cloudflare
	reverse_proxy balcao:80
}
