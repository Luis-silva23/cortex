# Docker Compose (docker-compose.yml): as senhas NÃO vêm escritas no compose; defina-as aqui (senha forte, só letras e números, pois
# entram em URL de conexão). O compose recusa subir sem elas.
#   POSTGRES_USER=lnsystem_admin         # SUPERUSUÁRIO do contêiner: só administração de emergência; nenhum serviço o usa
#   POSTGRES_PASSWORD=
#   POSTGRES_DB=lnsystem_db
#   DB_OWNER_PASSWORD=                   # dono das tabelas (roda as migrations) — papel lnsystem_owner
#   DB_APP_PASSWORD=                     # papel da API (só DML; é ele que faz a RLS valer) — lnsystem_app
#   DB_BACKUP_PASSWORD=                  # papel de backup (BYPASSRLS, só leitura) — lnsystem_backup
#   BACKUP_KEY_FILE=/caminho/fora/do/repo/backup.key   # arquivo com a chave de cifragem do backup (openssl rand -base64 48 > backup.key; chmod 600)
#   BACKUP_OFFSITE_CMD=                  # cópia externa, ex.: rclone copyto "$BACKUP_FILE" remoto:cortex/   (sem isto o backup NÃO protege contra perda do servidor)
#   BACKUP_ALERT_CMD=                    # aviso de falha: o texto vem em $BACKUP_ALERT_MSG
#   RLS_CONTEXT_SECRET=                  # segredo do contexto de RLS assinado (decisão 151): openssl rand -base64 32 — NUNCA o mesmo valor do JWT_SECRET; cofre separado
#   ALERT_WEBHOOK_URL=                   # webhook que ENTREGA o alerta a uma pessoa (use com BACKUP_ALERT_CMD="sh /opt/backup/alert-webhook.sh")
#   WAL_KEY_FILE=/caminho/fora/do/repo/wal.key         # PITR (docker-compose.wal.yml): chave de cifragem do WAL (openssl rand -base64 48 > wal.key); legível pelo uid 70
#   WAL_OFFSITE_CMD=                     # cópia externa de cada segmento de WAL: rclone copyto "$WAL_FILE" remoto:cortex-wal/   (sem isto o WAL fica no mesmo servidor)
#   WAL_ARCHIVE_TIMEOUT=300              # segundos entre trocas forçadas de segmento (limita a perda do WAL; proposta, não aprovada)
#   REDIS_PASSWORD=
#   PUBLIC_API_URL=https://api.seu-dominio.com.br   # URL pública (HTTPS) da API, para os builds do Admin Web e do Super Admin
#   TRUST_PROXY=1                                   # saltos de proxy confiáveis (ver abaixo)

# Database
# DESENVOLVIMENTO LOCAL apenas: as senhas "lnsystem123" abaixo são de exemplo e a API em NODE_ENV=production RECUSA subir com elas
# (config/env.ts). Em produção use um Postgres próprio, senha forte e `sslmode=require` na URL.
DATABASE_URL="postgresql://lnsystem:lnsystem123@localhost:5432/lnsystem_db?schema=public"

# Redis
# Se for usar o docker-compose.yml deste projeto, o Redis sobe com
# "--requirepass lnsystem123" — REDIS_PASSWORD e REDIS_URL precisam bater
# com isso (REDIS_URL é usado especificamente por advancedRateLimit.ts).
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="lnsystem123"
REDIS_DB=0
REDIS_URL="redis://:lnsystem123@localhost:6379/0"

# JWT — gere valores próprios (nunca reutilize os deste arquivo de exemplo):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cifra de segredos em repouso (AES-256-GCM, packages/shared/utils/secret-box.ts): segredo TOTP do MFA, senha do
# certificado e token CSC fiscais. OBRIGATÓRIA — a API não sobe sem ela. 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder a chave = perder os segredos cifrados (MFA precisa ser reconfigurado). Guarde junto do backup, fora do repo.
DATA_ENCRYPTION_KEY=""

# Backup / restauração (docs/CORTEX/DATABASE.md, "Backup e restauração")
# Role DEDICADO de backup (BYPASSRLS + pg_read_all_data): com FORCE RLS o role da aplicação copiaria tabelas vazias.
# Em PRODUÇÃO a API NÃO deve ter esta credencial (decisão 152): use BACKUP_MODE=delegated (padrão do docker-compose.yml) e deixe BACKUP_DATABASE_URL vazio; a API só
# PEDE o backup ao serviço `backup` e lista os manifestos. A API recusa subir em produção com BACKUP_DATABASE_URL ou BACKUP_MODE=local (salvo ALLOW_API_BACKUP_CREDENTIAL=true).
BACKUP_MODE="local"
BACKUP_DATABASE_URL=""
# Contexto de RLS assinado (decisão 151): HMAC-SHA256 que o banco confere antes de aceitar empresa/filiais/papel/usuário da sessão. Base64 de 32–64 bytes
# (`openssl rand -base64 32`), DIFERENTE do JWT_SECRET e do DATA_ENCRYPTION_KEY. Provisionado no banco por `npm run db:provision-context` (ou deploy/postgres-init/after-migrate.sql).
RLS_CONTEXT_SECRET=""
# Só para `npm run backup:verify` (cria e apaga um banco temporário de conferência): conexão de DBA.
RESTORE_ADMIN_URL=""
# Pasta dos binários pg_dump/pg_restore/psql quando não estão no PATH.
PG_BIN_DIR=""

# API
API_PORT=3001
API_HOST="localhost"
NODE_ENV="development"
# IP real do cliente atrás de proxy/balanceador (limite de tentativas, bloqueio por IP, auditoria). Número de saltos de proxy
# confiáveis (ex.: 1), loopback/linklocal/uniquelocal ou lista de IP/CIDR. NUNCA "true" (a API recusa em produção). Vazio = não confia
# em cabeçalho nenhum (correto sem proxy).
TRUST_PROXY=""
# HTTPS obrigatório em produção: a API (que não termina TLS) responde 426 a HTTP puro, exceto as sondas /api/health. Exige TRUST_PROXY
# (proxy com TLS enviando X-Forwarded-Proto); sem ele a API não sobe em produção. "false" só para rede interna sem TLS (a API avisa).
# ENFORCE_HTTPS=false
# Corte do legado de equipamento SEM chave (identificado só por id/MAC): depois desta data ele não entra mais e precisa ser registrado
# de novo. Padrão 2026-12-31T23:59:59-03:00; data inválida = a API não sobe em produção. Ver docs/CORTEX/DISPOSITIVOS.md §8.
# DEVICE_LEGACY_CUTOFF=2026-12-31T23:59:59-03:00
# Provedor SIMULADO do Integration Gateway: só fora de produção. Em produção só liga com "true" explícito (e a API avisa).
CHANNEL_SANDBOX_PROVIDER=""

# URLs
WEB_URL="http://localhost:3002"
SUPER_ADMIN_URL="http://localhost:3000"
# Origem do aplicativo Balcão (atendimento) — entra na lista de CORS da API. Em staging/produção: https://balcao.<domínio>.
BALCAO_URL="http://localhost:5174"

# Super Admin Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
SUPER_ADMIN_PORT=3000

# Admin Web (Empresas)
ADMIN_WEB_PORT=3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_TIME_MINUTES=30
# MFA obrigatório para Super Admin (conta privilegiada). Padrão: ligado só com NODE_ENV=production; true/false força.
# O enrolamento é administrativo (npm run admin:bootstrap -- enroll-mfa), nunca por senha padrão.
REQUIRE_MFA_PRIVILEGED=
# MFA obrigatório para o administrador da empresa (COMPANY_ADMIN): configura o autenticador na tela, no primeiro login.
# Padrão: ligado só em produção. Em produção a API RECUSA subir com "false" (e o mesmo vale para REQUIRE_MFA_PRIVILEGED).
REQUIRE_MFA_COMPANY_ADMIN=
# Hash de senha: Argon2id (padrão). Hashes bcrypt antigos continuam valendo e são migrados no login. "bcrypt" reverte a gravação.
# PASSWORD_HASH_ALGORITHM=argon2id
# ARGON2_MEMORY_KIB=19456   # memória por verificação; cada login simultâneo usa isto — dimensione pela concorrência
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# PASSWORD_LEGACY_BCRYPT=false   # desliga o custo extra de bcrypt quando não houver mais hash bcrypt ($2…) no banco
# Revogação de sessão: prazos (ms) das consultas ao Redis e ao PostgreSQL; estourar = cai para o PostgreSQL / 503.
# AUTH_REDIS_TIMEOUT_MS=750
# AUTH_DB_TIMEOUT_MS=3000
# Pedidos de titular (LGPD): anos de retenção de nome/CPF-CNPJ de cliente com documento fiscal autorizado (confirmar com o contador).
# PRIVACY_FISCAL_RETENTION_YEARS=5
# Em produção o bootstrap do Super Admin (npm run admin:bootstrap) só roda com esta variável = true, e só durante o
# procedimento: remova depois. A senha NUNCA vai aqui: vem de BOOTSTRAP_SA_PASSWORD no momento do comando ou de prompt oculto.
ALLOW_SUPER_ADMIN_BOOTSTRAP=

# BullMQ
BULLMQ_PREFIX="ln-system"

# Email — ATENÇÃO: nenhuma variável deste bloco (EMAIL_*, SENDGRID, AWS SES, SMTP_*, ENABLE_EMAIL_NOTIFICATIONS) é lida pelo código hoje
# (busca em apps/api/src, 2026-10-20; SMTP_HOST só faz o provedor de canal responder "nenhum transporte instalado"). O e-mail de alertas e de
# senha temporária usa o Resend (bloco RESEND_* mais abaixo, desligado sem chave). Mantido como exemplo de uma futura integração.
EMAIL_SERVICE="sendgrid" # ou "ses", "smtp"
EMAIL_FROM="noreply@lnsystem.com"
EMAIL_FROM_NAME="CÓRTEX"
# SendGrid
SENDGRID_API_KEY=""
# AWS SES
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Storage — ATENÇÃO: STORAGE_TYPE/STORAGE_PATH/S3_* NÃO são lidas pelo código hoje (2026-10-20). A cópia externa do backup usa rclone
# (BACKUP_OFFSITE_CMD + RCLONE_CONFIG_OFFSITE_*, ver docs/CORTEX/PRODUCAO.md §19), não estas variáveis.
STORAGE_TYPE="local" # ou "s3"
STORAGE_PATH="./storage"
# AWS S3
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Logs
LOG_LEVEL="info" # debug, info, warn, error
LOG_FILE_PATH="./logs"
LOG_MAX_FILES=30

# Features
ENABLE_AUDIT_LOG=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_AUTO_BACKUP=false
ENABLE_SCHEDULER=true

# Payment Gateways — ATENÇÃO: NÃO são lidas pelo código hoje (2026-10-20): não há integração com Mercado Pago, PagSeguro nem Stripe
# (o módulo de canais/pagamento externo só tem o provedor simulado; ver docs/CORTEX/INTEGRATION_GATEWAY.md).
MERCADOPAGO_ACCESS_TOKEN=""
PAGSEGURO_TOKEN=""
STRIPE_SECRET_KEY=""

# Monitoring (opcional): SENTRY_DSN é lida (envio só com DSN; ver bloco "Central de Monitoramento" abaixo). DATADOG_API_KEY NÃO é lida pelo código.
SENTRY_DSN=""
DATADOG_API_KEY=""

# Central de Monitoramento (Super Admin) — tudo opcional; sem estas variáveis o monitoramento NATIVO e a central de alertas funcionam sozinhos.
# Valores abaixo são os padrões; os ajustes feitos na tela "Serviços externos" só RESTRINGEM (o ambiente é o teto). Nunca coloque chave real neste arquivo.
# Sentry (erros): sem SENTRY_DSN nada é enviado. O plano gratuito do provedor tem limite mensal próprio — confira antes de ligar.
SENTRY_ENVIRONMENT=""            # padrão: NODE_ENV
SENTRY_RELEASE=""
SENTRY_SAMPLE_RATE=0.25          # 0 a 1
SENTRY_MAX_EVENTS_PER_HOUR=30
SENTRY_MAX_EVENTS_PER_DAY=200
SENTRY_DEDUPE_MINUTES=5
# Resend (e-mail de alertas): só envia com chave + remetente em domínio VERIFICADO + destinatários + RESEND_DOMAIN_VERIFIED=true
RESEND_API_KEY=""
ALERT_EMAIL_FROM=""              # remetente em domínio verificado no provedor
ALERT_EMAIL_TO=""                # lista separada por vírgula
RESEND_DOMAIN_VERIFIED=false
RESEND_TRANSACTIONAL=false       # e-mails transacionais (senha temporária etc.) exigem este "sim" explícito
ALERT_EMAIL_MIN_SEVERITY="CRITICAL"
ALERT_EMAIL_MAX_PER_HOUR=6
ALERT_EMAIL_MAX_PER_DAY=30
ALERT_EMAIL_MAX_PER_MONTH=600
ALERT_EMAIL_DEDUPE_MINUTES=60
# Coleta e retenção locais (controle de volume/custo)
MONITORING_SAMPLE_MINUTES=5
MONITORING_SAMPLES_MAX_PER_DAY=4000
MONITORING_SAMPLE_RETENTION_DAYS=30
MONITORING_DELIVERY_RETENTION_DAYS=60
MONITORING_ALERT_RETENTION_DAYS=365
# Backup (estado exibido na Central): pasta onde o serviço de backup publica manifestos/status/verificação (somente leitura)
BACKUP_PUBLIC_DIR=""
BACKUP_MAX_AGE_HOURS=26
# Endereços públicos usados para avaliar "pronto para produção" (a Central só lê; nenhum domínio fixo no código)
API_ORIGIN=""

# Printer (PDV)
ENABLE_PRINTER=false
PRINTER_TYPE="thermal" # thermal, laser
PRINTER_NAME=""

# License
DEFAULT_TRIAL_DAYS=30

