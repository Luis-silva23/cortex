  /// Dinheiro: valor entregue pelo cliente (`amount` é o que foi aplicado à venda; a diferença é o troco).
  receivedAmount    Decimal?      @db.Decimal(10, 2)
  changeAmount      Decimal       @default(0) @db.Decimal(10, 2)
  /// Dinheiro com controle de cédulas ligado: [{ value, quantity }] que somam `receivedAmount`.
  cashBreakdown     Json?
  /// Provedor externo que processou (terminal/PSP registrado); nulo = dinheiro/MANUAL. Usado na reconciliação.
  provider          String?
  /// Convênio usado (forma de pagamento EMPLOYEE_AGREEMENT / COMPANY_AGREEMENT)
  agreementCompanyId  String?
  employeeAgreementId String?
  installments      Int           @default(1)
  transactionId     String?       @unique
  authorizationCode String?
  cardBrand         String?
  cardLastDigits    String?
