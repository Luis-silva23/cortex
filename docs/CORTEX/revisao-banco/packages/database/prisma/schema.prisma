/// Partial UNIQUE indexes for "one active session per device" / "per user"
/// exist only at the database level (WHERE status = 'ACTIVE') and are not
/// representable as a Prisma @@unique — see migration.sql.
model DeviceSession {
  id         String              @id @default(uuid())
  deviceId   String
  device     Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  user       User                @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  companyId  String
  branchId   String?
  status     DeviceSessionStatus @default(ACTIVE)
  startedAt  DateTime            @default(now())
  endedAt    DateTime?
  endedBy    String?
  endReason  String?
  ipAddress  String?

  company Company @relation("DeviceSession_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("DeviceSession_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId])
  @@index([deviceId])
  @@index([status])
  @@index([userId])
  @@map("device_sessions")
}

model Device {
  id               String       @id @default(uuid())
  /// Nulo SÓ enquanto o equipamento está aguardando autorização (enrolamento sem empresa): quem o vincula a uma licença (e,
  /// portanto, a uma empresa) e a uma filial é o administrador, ao autorizar. Um equipamento ACTIVE sempre tem licença (CHECK).
  licenseId        String?
  license          License?     @relation(fields: [licenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Filial de atendimento definida na autorização (o equipamento não escolhe filial). Escalar simples, sem FK, como as demais.
  branchId         String?
  /// SHA-256 da chave do equipamento (entregue UMA vez no enrolamento e guardada no cofre do aplicativo). Nulo nos equipamentos
  /// anteriores ao enrolamento (identidade só por id/MAC: legado, a reenrolar).
  secretHash       String?
  /// Código curto que o administrador confere com a tela do equipamento ao autorizar.
  enrollmentCode   String?      @unique
  deviceName       String
  deviceType       DeviceType
  status           DeviceStatus @default(PENDING)
  macAddress       String?
  ipAddress        String?
  lastSeenAt       DateTime?
  activatedBy      String?
  activatedAt      DateTime?
  revokedBy        String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  activations     Activation[]
  deviceSessions  DeviceSession[]

  @@index([lastSeenAt])
  @@index([licenseId])
  @@index([status])
  @@map("devices")
}

/// roleId has no FK to Role (verified against the DDL) — plain scalar.
model DiscountRule {
  id               String       @id @default(uuid())
  companyId        String
  name             String
  description      String?
  userType         UserType?
  roleId           String?
  discountType     DiscountType
  maxDiscount      Decimal      @db.Decimal(5, 2)
  requiresApproval Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company Company @relation("DiscountRule_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId])
  @@index([roleId])
  @@index([userType])
  @@map("discount_rules")
}

