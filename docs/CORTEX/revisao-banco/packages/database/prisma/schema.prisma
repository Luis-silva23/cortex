/// branchId is a plain scalar — no FK (unlike User.branchId, which does have
/// one).
/// Filiais ADICIONAIS autorizadas a um usuário de filial (decisão 153). O conjunto autorizado de quem NÃO é de empresa inteira é
/// `users.branchId` (principal) + as linhas desta tabela; é calculado no servidor a cada requisição (nunca vem do cliente) e viaja assinado no
/// contexto da RLS. Só SUPER_ADMIN e COMPANY_ADMIN gravam (RLS); o usuário lê as próprias linhas. Apagar o vínculo revoga o acesso na hora.
model UserBranch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation("UserBranch_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId    String
  user      User     @relation("UserBranch_user", fields: [companyId, userId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  branchId  String
  branch    Branch   @relation("UserBranch_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  /// Quem concedeu o vínculo (id do administrador); a trilha completa fica em audit_logs.
  createdBy String?

  @@unique([userId, branchId])
  @@index([companyId, branchId])
  @@map("user_branches")
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId   String
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branchId String?

  @@unique([userId, roleId, branchId])
  @@map("user_roles")
}

model User {
  id              String    @id @default(uuid())
  numericId       Int       @unique @default(autoincrement())
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name            String
  email           String    @unique
  phone           String?
  password        String
  userType        UserType
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  mfaBackupCodes  String[]  @default([])
  /// Último passo TOTP (30 s) já consumido: o mesmo código não vale duas vezes (decisão 123).
  mfaLastStep     Int?
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  /// Senha TEMPORÁRIA (definida por um administrador): o usuário precisa trocá-la antes de receber sessão (decisão 157).
  mustChangePassword Boolean @default(false)
  /// Quando a senha foi trocada pela última vez (pelo próprio usuário ou redefinida por um administrador).
  passwordChangedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activations            Activation[]
  auditLogs              AuditLog[]
  deviceSessions         DeviceSession[]
  refreshTokens          RefreshToken[]
  refreshTokensInCompany RefreshToken[] @relation("RefreshTokenUserCompany")
  sales                  Sale[]
  serviceOrdersAsMechanic ServiceOrder[] @relation("ServiceOrderMechanic")
  userRoles              UserRole[]
  /// Filiais ADICIONAIS autorizadas (decisão 153); a principal continua em users.branchId.
  userBranchesInUser UserBranch[] @relation("UserBranch_user")

  /// Alvo das FKs compostas (companyId, userId) — ver RefreshToken; redundante com a PK.
  cashRegisterUsers CashRegister[] @relation("CashRegister_userId")
  employeeAgreementUsers EmployeeAgreement[] @relation("EmployeeAgreement_userId")
  importBatchUsers ImportBatch[] @relation("ImportBatch_userId")
  stockMovementUsers StockMovement[] @relation("StockMovement_userId")
  supplierReturnEventUsers SupplierReturnEvent[] @relation("SupplierReturnEvent_userId")
  @@unique([companyId, id])
  @@index([branchId])
  @@index([companyId, isActive])
  @@index([isActive])
  @@map("users")
}

model VehicleEntryChecklistItem {
