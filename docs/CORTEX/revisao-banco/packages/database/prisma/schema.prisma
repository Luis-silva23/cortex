  sku                String
  barcode            String?
  name               String
  description        String?
  brand              String?
  application        String?
  location           String?
  productType        ProductType @default(PRODUCT)
  costPrice          Decimal     @db.Decimal(10, 2)
  salePrice          Decimal     @db.Decimal(10, 2)
  minStock           Int         @default(0)
  maxStock           Int?
  unit               String      @default("UN")
  isActive           Boolean     @default(true)
  allowNegativeStock Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  comboItems   ComboItem[]          @relation("ComboItemCombo")
  comboItemsAsProduct ComboItem[]          @relation("ComboItemProduct")
  damageRecords       DamageRecord[]
  inventoryCounts     InventoryCount[]
  purchaseOrderItems  PurchaseOrderItem[]
  saleItems           SaleItem[]
  serviceOrderItems   ServiceOrderItem[]
  stockMovements      StockMovement[]
  channelLinks        ChannelProductLink[]
  externalOrderItems  ExternalOrderItem[]
  stockReservations   StockReservation[]
  supplierReturnItems SupplierReturnItem[]
  transferItems       TransferItem[]
  barcodes            ProductBarcode[]
  image               ProductImage?

  company Company @relation("Product_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("Product_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, sku])
  /// Redundante com a PK (`id` já é único), mas é o ALVO exigido pelas FKs compostas (companyId, productId) de `product_barcodes` e
  /// `product_images`, que impedem uma linha da empresa A de apontar para produto da empresa B. Migração 20261014160000.
  @@unique([companyId, id])
  @@index([barcode])
  @@index([branchId])
  @@index([categoryId])
  @@index([companyId, isActive])
  @@index([isActive])
  @@index([sku])
  @@map("products")
