/// Fato do provedor em conflito com a venda (ex.: aprovado depois do cancelamento/devolução). O pagamento guarda a
/// verdade; a exceção fica aberta até ser tratada. Tratamento comercial: [DECISÃO NECESSÁRIA] (docs/CORTEX/BUSINESS_RULES.md).
/// Máximo uma aberta por pagamento (índice parcial `payment_exceptions_one_open`, na migração).
model PaymentException {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  paymentId      String
  payment        Payment   @relation(fields: [companyId, paymentId], references: [companyId, id], onDelete: Restrict)
  saleId         String
  type           String
  saleStatus     String
  amount         Decimal   @db.Decimal(10, 2)
  provider       String?
  providerStatus String
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolution     String?
  resolvedBy     String?
  notes          String?

  sale Sale @relation("PaymentException_saleId", fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  company Company @relation("PaymentException_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("PaymentException_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId, resolvedAt])
  @@index([saleId])
  @@map("payment_exceptions")
}

