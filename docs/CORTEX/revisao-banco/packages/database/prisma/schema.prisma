  totalAmount           Decimal               @db.Decimal(10, 2)
  xmlUrl                String?
  pdfUrl                String?
  qrCode                String?
  issuedAt              DateTime?
  authorizedAt          DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  rejectionReason       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  sale Sale? @relation("FiscalDocument_saleId", fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrder ServiceOrder? @relation("FiscalDocument_serviceOrderId", fields: [companyId, serviceOrderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  company Company @relation("FiscalDocument_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("FiscalDocument_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, branchId, documentType, series, number])
  @@index([branchId])
