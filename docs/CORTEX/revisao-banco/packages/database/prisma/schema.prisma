  source              String    @default("ADMIN_WEB")
  appVersion          String?
  /// Contexto da tela (módulo, tela, entidade validada no servidor, rótulo seguro) — sem dado sensível
  context             Json?
  assignedToId        String?
  assignedToName      String?
  assignedAt          DateTime?
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  lastMessageAt       DateTime  @default(now())
  lastMessageBy       String    @default("REQUESTER")
  requesterLastReadAt DateTime  @default(now())
  supportLastReadAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  messages    SupportTicketMessage[]
  attachments SupportTicketAttachment[]
  events      SupportTicketEvent[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("SupportTicket_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("SupportTicket_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([companyId, status, createdAt])
  @@index([companyId, branchId])
  @@index([requesterId, createdAt])
  @@index([assignedToId, status])
  @@index([module])
  @@index([status, createdAt])
  @@map("support_tickets")
}

/// Mensagem do chamado — só cresce (sem edição nem exclusão pela aplicação).
model SupportTicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [companyId, ticketId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  companyId  String
  branchId   String?
  authorId   String
  authorName String
  /// REQUESTER | COMPANY | SUPPORT
  authorRole String
  body       String
  statusFrom String?
  statusTo   String?
  source     String        @default("ADMIN_WEB")
  createdAt  DateTime      @default(now())

  attachments SupportTicketAttachment[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("SupportTicketMessage_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("SupportTicketMessage_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// Anexo guardado no banco (sob RLS), baixado só por rota autorizada. Remoção é lógica.
model SupportTicketAttachment {
  id         String                @id @default(uuid())
  ticketId   String
  ticket     SupportTicket         @relation(fields: [companyId, ticketId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  messageId  String?
  message    SupportTicketMessage? @relation(fields: [companyId, messageId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  companyId  String
  branchId   String?
  fileName   String
  mimeType   String
  size       Int
  sha256     String
  data       Bytes
  uploadedBy String
  uploadedByName String
  removedAt  DateTime?
  removedBy  String?
  createdAt  DateTime              @default(now())

  company Company @relation("SupportTicketAttachment_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("SupportTicketAttachment_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([ticketId])
  @@index([companyId])
  @@map("support_ticket_attachments")
}

/// Histórico imutável do chamado (abertura, status, atribuição, prioridade, anexos, reabertura, encerramento).
model SupportTicketEvent {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [companyId, ticketId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  companyId  String
  branchId   String?
  type       String
  fromValue  String?
  toValue    String?
  actorId    String
  actorName  String
  actorRole  String
  createdAt  DateTime      @default(now())

  company Company @relation("SupportTicketEvent_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("SupportTicketEvent_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([ticketId, createdAt])
  @@index([companyId])
  @@map("support_ticket_events")
}

/// Base de conhecimento (global, do produto): leitura para todos os usuários logados, escrita só da plataforma.
model SupportKbCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  articles SupportKbArticle[]

  @@map("support_kb_categories")
}

model SupportKbArticle {
  id          String            @id @default(uuid())
  categoryId  String
  category    SupportKbCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slug        String            @unique
  title       String
  summary     String?
  body        String
  keywords    String?
  module      String?
  /// DRAFT | PUBLISHED
  status      String            @default("DRAFT")
  authorId    String
  authorName  String
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  /// Coluna GERADA (`GENERATED ALWAYS AS … STORED`, tsvector, português: título A, resumo+palavras-chave B, corpo C) — mantida pelo banco, nunca
  /// escrita pela aplicação. O `dbgenerated` abaixo é a expressão de geração como o PostgreSQL a guarda (é o que o `db pull` devolve): sem ele o
  /// `migrate diff` propõe `ALTER COLUMN "search" DROP DEFAULT`; sem o índice GIN, `DROP INDEX "support_kb_articles_search_idx"` (a busca
  /// `websearch_to_tsquery` de `support-kb.service.ts` cairia em varredura sequencial).
  search      Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('portuguese'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('portuguese'::regconfig, ((COALESCE(summary, ''::text) || ' '::text) || COALESCE(keywords, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('portuguese'::regconfig, COALESCE(body, ''::text)), 'C'::\"char\"))"))

  @@index([categoryId, status])
  @@index([search], type: Gin)
  @@map("support_kb_articles")
}

// ============================================================================
// CANAIS DE VENDA (2026-10-04) — base para loja física, site próprio, iFood e marketplaces.
// Nada aqui conecta a um serviço externo: o módulo CANAIS nasce DESATIVADO e nenhum canal nasce "Conectado".
// Pedido externo NÃO é venda: `ExternalOrder` guarda o que chegou; a venda (`Sale`) só nasce por conversão deliberada.
// ============================================================================

/// Tipo técnico (identificador estável; o nome exibido é configurável em `SalesChannel.displayName`).
enum SalesChannelType {
  LOJA_FISICA
  SITE_PROPRIO
  IFOOD
  MARKETPLACE
  OUTRO
}

/// CONNECTED só é gravado depois de um teste real de conexão do provedor; salvar credencial não conecta.
enum ChannelConnectionStatus {
  NOT_CONFIGURED
  UNVALIDATED
  CONNECTED
  ERROR
}

/// Ciclo do PEDIDO externo (não confundir com venda, pagamento ou documento fiscal).
enum ExternalOrderStatus {
  RECEIVED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
  /// A reserva venceu sem pagamento confirmado (ou o pedido não foi tratado a tempo).
  EXPIRED
}

enum ExternalPaymentStatus {
  UNKNOWN
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// Canal de venda configurado por empresa (`branchId` nulo = todas as filiais). Venda sem canal = loja física. Credencial só
/// cifrada (`enc:v1`, mesma chave dos segredos fiscais) e nunca devolvida pela API; `type` não muda depois de criado.
model SalesChannel {
  id                   String                  @id @default(uuid())
  companyId            String
  branchId             String?
  type                 SalesChannelType
  displayName          String
  isActive             Boolean                 @default(false)
  /// Chave do provedor de integração (ex.: "ifood"); nula = sem integração (loja física).
  provider             String?
  connectionStatus     ChannelConnectionStatus @default(NOT_CONFIGURED)
  lastSyncAt           DateTime?
  lastError            String?
  /// Posição de leitura da consulta periódica ao provedor (Integration Gateway); opaca, só o provedor a interpreta.
  inboundCursor        String?
  externalAccountId    String?
  /// Configuração NÃO secreta.
  config               Json?
  credentialsEncrypted String?
  /// Dica não reversível ("••••1234") para a tela.
  credentialsHint      String?
  createdBy            String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  sales          Sale[]
  events         ChannelEvent[]
  externalOrders ExternalOrder[]
  inboundEvents  ChannelInboundEvent[]
  apiCredentials ChannelApiCredential[]
  productLinks   ChannelProductLink[]
  externalPayments ExternalPayment[]
  stockReservations StockReservation[]
  outbox            ChannelOutbox[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("SalesChannel_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("SalesChannel_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([companyId])
  @@index([companyId, branchId])
  @@map("sales_channels")
}

/// Registro de acontecimentos do canal (configuração, teste de conexão, webhook recusado, pedido recebido, erro). Sem segredo.
model ChannelEvent {
  id            String       @id @default(uuid())
  companyId     String
  branchId      String?
  channelId     String
  channel       SalesChannel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  type          String
  level         String       @default("INFO")
  message       String
  correlationId String?
  actorId       String?
  data          Json?
  createdAt     DateTime     @default(now())

  company Company @relation("ChannelEvent_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ChannelEvent_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([channelId, createdAt])
  @@index([companyId, createdAt])
  @@map("channel_events")
}

/// Pedido recebido de um canal. A chave (canal, pedido externo) é única: o mesmo pedido recebido de novo não cria outro.
model ExternalOrder {
  id              String                @id @default(uuid())
  companyId       String
  branchId        String?
  channelId       String
  channel         SalesChannel          @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  externalOrderId String
  status          ExternalOrderStatus   @default(RECEIVED)
  paymentStatus   ExternalPaymentStatus @default(UNKNOWN)
  /// Preenchido só quando o pedido vira venda (conversão deliberada; nunca na chegada). Único: um pedido nunca gera duas vendas.
  saleId          String?               @unique
  sale            Sale?                 @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  acceptedAt      DateTime?
  acceptedBy      String?
  convertedAt     DateTime?
  reservations    StockReservation[]
  fulfillment     Fulfillment?
  /// Resumo validado do que chegou (sem dados de pagamento sensíveis).
  payload         Json
  /// Total calculado pelo CÓRTEX com o preço oficial (nunca o valor que o canal afirmou). Nulo em pedido recebido por webhook de provedor.
  totalAmount     Decimal?              @db.Decimal(12, 2)
  /// O que o canal disse que era o total (só para conferência; não é fonte de cobrança).
  channelTotal    Decimal?              @db.Decimal(12, 2)
  /// COMMERCE_API (pedido criado pela Commerce API) ou WEBHOOK (evento de provedor).
  source          String                @default("WEBHOOK")
  correlationId   String?
  /// Motivo da última mudança de estado do pedido (recusa, cancelamento).
  statusReason    String?
  statusChangedAt DateTime?
  receivedAt      DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items           ExternalOrderItem[]
  payments        ExternalPayment[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  /// Exigida pelo Prisma na relação 1:1 pela FK composta; redundante com o @unique da coluna (migração 20261014180000_composite_company_fks).
  company Company @relation("ExternalOrder_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ExternalOrder_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, saleId])
  @@unique([companyId, id])
  @@unique([channelId, externalOrderId])
  @@index([companyId, receivedAt])
  @@map("external_orders")
}

/// Idempotência e anti-repetição de eventos/webhooks: (canal, evento externo, operação) é único.
model ChannelInboundEvent {
  id              String       @id @default(uuid())
  companyId       String
  branchId        String?
  channelId       String
  channel         SalesChannel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  externalEventId String
  operation       String
  /// RECEIVED (reivindicado), APPLIED, DEFERRED (pedido ainda desconhecido: fora de ordem), REJECTED (regra de negócio), REVIEW, FAILED.
  outcome         String
  receivedAt      DateTime     @default(now())
  /// Integration Gateway (Fase 3): evento normalizado (sem cabeçalhos, sem segredo), para reprocessar o que chegou fora de ordem.
  payload         Json?
  occurredAt      DateTime?
  /// Identificador do pedido no canal a que o evento se refere (para aplicar o que ficou esperando o pedido chegar).
  orderRef        String?
  correlationId   String?
  attempts        Int          @default(0)
  processedAt     DateTime?
  lastError       String?

  company Company @relation("ChannelInboundEvent_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ChannelInboundEvent_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([channelId, externalEventId, operation])
  @@index([companyId, receivedAt])
  @@index([channelId, orderRef, outcome])
  @@index([outcome, receivedAt])
  @@map("channel_inbound_events")
}

/// Caixa de saída (Integration Gateway, Fase 3): tudo o que o CÓRTEX precisa dizer a um provedor externo (estoque, preço, catálogo,
/// estado do pedido, entrega) é GRAVADO aqui, na mesma transação da mudança, e enviado depois por rotina com prazo, retentativa
/// e disjuntor. Nenhuma chamada externa roda no caminho do PDV. `dedupeKey` único por canal: o mesmo aviso nunca é enfileirado duas vezes.
enum ChannelOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
  CANCELLED
}

model ChannelOutbox {
  id            String              @id @default(uuid())
  companyId     String
  branchId      String?
  channelId     String
  channel       SalesChannel        @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  /// INVENTORY_SYNC | PRICE_SYNC | CATALOG_SYNC | ORDER_STATUS | FULFILLMENT_STATUS
  type          String
  dedupeKey     String
  /// Dados de negócio a enviar (SKU, quantidade, estado). Nunca credencial, nunca cabeçalho.
  payload       Json
  status        ChannelOutboxStatus @default(PENDING)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(8)
  nextAttemptAt DateTime            @default(now())
  /// Prazo máximo na caixa: depois dele a linha vira DEAD em vez de ser enviada velha.
  deadlineAt    DateTime
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String?
  lastErrorKind String?
  correlationId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company @relation("ChannelOutbox_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ChannelOutbox_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([channelId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([companyId, channelId, status])
  @@map("channel_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMERCE API (Fase 1, 2026-10-05) — docs/CORTEX/COMMERCE_API.md
// ─────────────────────────────────────────────────────────────────────────────

/// O que a credencial de um canal pode fazer na Commerce API.
enum ChannelCredentialScope {
  CATALOG_READ
  ORDERS_READ
  ORDERS_WRITE
  PAYMENT_EVENTS_WRITE
}

/// Credencial que um CANAL usa para chamar o CÓRTEX (servidor → servidor, assinatura HMAC por requisição). NÃO é a credencial que o
/// CÓRTEX usa num provedor (essa é `SalesChannel.credentialsEncrypted`). O segredo é cifrado (`enc:v1`) porque o HMAC precisa dele;
/// aparece UMA vez, na criação, e nunca mais é devolvido. A empresa e a filial do canal vêm daqui, nunca da requisição.
model ChannelApiCredential {
  id              String                   @id @default(uuid())
  companyId       String
  branchId        String?
  channelId       String
  channel         SalesChannel             @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  /// Identificador público (`ck_` + hex); único no sistema para a busca antes de existir contexto de empresa.
  keyId           String                   @unique
  secretEncrypted String
  /// Dica não reversível ("••••ab12") para a tela.
  secretHint      String
  label           String
  scopes          ChannelCredentialScope[]
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedBy       String?
  lastUsedAt      DateTime?
  createdBy       String
  createdAt       DateTime                 @default(now())

  company Company @relation("ChannelApiCredential_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ChannelApiCredential_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([channelId])
  @@index([companyId])
  @@map("channel_api_credentials")
}

/// Publicação de um produto para um canal. O CÓRTEX continua sendo o mestre do catálogo: aqui só há o vínculo e o estado
/// (nada é público até ser publicado). Não há cópia do produto.
model ChannelProductLink {
  id          String       @id @default(uuid())
  companyId   String
  branchId    String?
  channelId   String
  channel     SalesChannel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  productId   String
  product     Product      @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  published   Boolean      @default(false)
  /// Identificador do produto no canal (SKU externo), quando houver.
  externalId  String?
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation("ChannelProductLink_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ChannelProductLink_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([channelId, productId])
  @@index([companyId])
  @@index([channelId, published])
  @@map("channel_product_links")
}

/// Linha de um pedido externo, já resolvida contra o catálogo do CÓRTEX (produto, preço oficial). Imutável depois de criada.
model ExternalOrderItem {
  id               String        @id @default(uuid())
  companyId        String
  branchId         String?
  orderId          String
  order            ExternalOrder @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  productId        String
  product          Product       @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  sku              String
  name             String
  quantity         Decimal       @db.Decimal(10, 3)
  /// Preço que o canal mostrou ao cliente.
  channelUnitPrice Decimal       @db.Decimal(10, 2)
  /// Preço oficial do CÓRTEX no momento do pedido (a Commerce API recusa o pedido se for diferente).
  unitPrice        Decimal       @db.Decimal(10, 2)
  lineTotal        Decimal       @db.Decimal(12, 2)

  company Company @relation("ExternalOrderItem_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ExternalOrderItem_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([orderId])
  @@index([productId])
  @@index([companyId])
  @@map("external_order_items")
}

/// Pagamento de um pedido externo — separado do pedido e da venda. `providerRef` único por canal impede o mesmo pagamento duas vezes.
/// Hoje o CÓRTEX só RECEBE eventos de pagamento (informados pelo canal/provedor); não cobra.
model ExternalPayment {
  id          String                @id @default(uuid())
  companyId   String
  branchId    String?
  channelId   String
  channel     SalesChannel          @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  orderId     String
  order       ExternalOrder         @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  providerRef String
  status      ExternalPaymentStatus @default(PENDING)
  amount      Decimal               @db.Decimal(12, 2)
  /// CHANNEL_REPORTED (o canal informou) ou PROVIDER_CONFIRMED (confirmado direto pelo provedor de pagamento; Fase 3).
  source      String                @default("CHANNEL_REPORTED")
  /// Forma de pagamento informada pelo canal (opcional); sem informação = OUTRO. Vira a forma do `Payment` na conversão em venda.
  method      PaymentMethod         @default(OTHER)
  lastEventAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company Company @relation("ExternalPayment_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ExternalPayment_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([channelId, providerRef])
  @@index([orderId])
  @@index([companyId, status])
  @@map("external_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// RESERVA DE ESTOQUE E FULFILLMENT (Fase 2, 2026-10-05) — docs/CORTEX/COMMERCE_API.md §4, §5 e §11
// ─────────────────────────────────────────────────────────────────────────────

enum StockReservationStatus {
  /// Reservado: tira a quantidade do DISPONÍVEL para venda (o saldo físico do livro não muda).
  ACTIVE
  /// Virou venda: o movimento `SALE` foi gravado na mesma transação.
  CONSUMED
  /// Liberado (cancelamento, recusa, falha de pagamento ou liberação manual), com motivo.
  RELEASED
  /// Venceu (`expiresAt` no passado) sem virar venda.
  EXPIRED
}

/// Reserva de estoque de um pedido externo. NÃO é movimento do livro (o inventário fixa o saldo absoluto e apagaria uma reserva):
/// é uma promessa temporária. Disponível para venda = saldo do livro da filial − reservas ACTIVE ainda não vencidas.
/// Uma linha por (pedido, produto); a reserva do pedido nasce e morre inteira.
model StockReservation {
  id           String                 @id @default(uuid())
  companyId    String
  /// Filial de atendimento (a do canal).
  branchId     String
  channelId    String
  channel      SalesChannel           @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  orderId      String
  order        ExternalOrder          @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  productId    String
  product      Product                @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  quantity     Decimal                @db.Decimal(10, 3)
  status       StockReservationStatus @default(ACTIVE)
  expiresAt    DateTime
  closedAt     DateTime?
  /// Por que deixou de estar ativa (CONVERTED, ORDER_CANCELLED, ORDER_REJECTED, PAYMENT_FAILED, MANUAL, EXPIRED…).
  closedReason String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  company Company @relation("StockReservation_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("StockReservation_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([orderId, productId])
  @@index([branchId, productId, status])
  @@index([status, expiresAt])
  @@index([companyId])
  @@index([productId])
  @@map("stock_reservations")
}

enum FulfillmentType {
  PICKUP
  OWN_DELIVERY
  CHANNEL_DELIVERY
}

enum FulfillmentStatus {
  PENDING
  READY
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

/// Entrega física do que foi vendido — separada da venda (uma venda existe sem o fulfillment concluído). Nasce `PENDING` na conversão
/// do pedido em venda. O tipo (retirada, entrega própria, entrega do canal) fica nulo até a regra de produto existir (DECISIONS 91).
model Fulfillment {
  id              String            @id @default(uuid())
  companyId       String
  branchId        String
  orderId         String            @unique
  order           ExternalOrder     @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  saleId          String            @unique
  sale            Sale              @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  type            FulfillmentType?
  status          FulfillmentStatus @default(PENDING)
  statusChangedAt DateTime          @default(now())
  statusChangedBy String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /// Exigida pelo Prisma na relação 1:1 pela FK composta; redundante com o @unique da coluna (migração 20261014180000_composite_company_fks).
  /// Exigida pelo Prisma na relação 1:1 pela FK composta; redundante com o @unique da coluna (migração 20261014180000_composite_company_fks).
  company Company @relation("Fulfillment_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("Fulfillment_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, saleId])
  @@unique([companyId, orderId])
  @@index([companyId, status])
  @@map("fulfillments")
}

/// Revogação DURÁVEL de access token (decisão 107, 2026-10-14). O Redis continua sendo o caminho rápido; esta tabela é a fonte de
/// verdade quando o Redis está fora do ar (o middleware consulta aqui em vez de aceitar o token revogado) e a origem da
/// ressincronização do Redis quando ele volta. kind: TOKEN (subject = sha256 do token), USER ou COMPANY (subject = id; revokedAt =
/// "tudo emitido até este instante está revogado"). Linhas expiram sozinhas (expiresAt) e são limpas pela própria aplicação.
model AccessRevocation {
  id        String   @id @default(uuid())
  kind      String
  subject   String
  revokedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([kind, subject])
  @@index([expiresAt])
  @@map("access_revocations")
}

/// Pedido de titular (LGPD, decisão 120): exportação dos dados ou anonimização de UM cliente, sempre pelo administrador da empresa.
/// A linha é o registro durável do pedido (quem, quando, por quê, o que foi feito e o que foi RETIDO e por quê). Nunca guarda o dado
/// anonimizado. O arquivo de exportação, quando existe, fica cifrado (enc:v1) só até exportExpiresAt e é apagado por rotina.
model PrivacyRequest {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// EXPORT | ANONYMIZE
  requestType     String
  subjectType     String    @default("CUSTOMER")
  subjectId       String
  /// PLANNED (anonimização planejada, aguardando confirmação) | COMPLETED | PARTIAL (parte retida por obrigação) | BLOCKED | FAILED
  status          String
  justification   String
  requestedBy     String
  requestedAt     DateTime  @default(now())
  executedBy      String?
  executedAt      DateTime?
  /// Anonimização: o que seria anonimizado e o que seria retido (só contagens e motivos — sem dado pessoal).
  plan            Json?
  /// Resultado: contagens por tabela e retenções aplicadas (sem dado pessoal).
  result          Json?
  retainedUntil   DateTime?
  /// Exportação: JSON cifrado (enc:v1), sha256 do arquivo em claro, validade e contagem de downloads.
  exportPayload   String?
  exportSha256    String?
  exportExpiresAt DateTime?
  exportDownloads Int       @default(0)
  exportPurgedAt  DateTime?
  failureCode     String?
  updatedAt       DateTime  @updatedAt

  @@index([companyId, requestedAt])
  @@index([companyId, subjectId])
  @@index([exportExpiresAt])
  @@map("privacy_requests")
}

/// Imagem OPCIONAL do produto (decisão 122, 2026-10-14): no máximo uma por produto, guardada no banco sob RLS (mesma arquitetura dos anexos
/// do Suporte — nenhum armazenamento de arquivo externo existe) e entregue só por rota autenticada da própria empresa. O conteúdo é
/// VALIDADO e SANEADO antes de gravar (PNG/JPEG/WebP reais, sem metadados, sem bytes sobrando, dimensões e tamanho limitados).
model ProductImage {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String   @unique
  /// FK composta (companyId, productId) → products(companyId, id): a imagem é sempre da mesma empresa do produto (ver `ProductBarcode`).
  product   Product  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  mimeType  String
  byteSize  Int
  width     Int
  height    Int
  sha256    String
  data      Bytes
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Exigida pelo Prisma para a relação 1:1 pela FK composta; redundante com `productId @unique` (migração 20261014161000).
  @@unique([companyId, productId])
  @@index([companyId])
  @@map("product_images")
}
