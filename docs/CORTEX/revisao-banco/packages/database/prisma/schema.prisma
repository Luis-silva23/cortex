model DamageRecord {
  id            String       @id @default(uuid())
  companyId     String
  branchId      String
  productId     String
  product       Product      @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  quantity      Decimal      @db.Decimal(10, 3)
  reason        DamageReason
  description   String?
  photoUrls     String?
  approvedBy    String
  recordedBy    String
  recordedAt    DateTime     @default(now())
  isReversed    Boolean      @default(false)
  reversedAt    DateTime?
  reversedBy    String?
  reverseReason String?
  createdAt     DateTime     @default(now())

  supplierReturnItemDamageRecords SupplierReturnItem[] @relation("SupplierReturnItem_damageRecordId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("DamageRecord_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("DamageRecord_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([branchId])
  @@index([isReversed])
  @@index([productId])
  @@index([recordedAt])
