  discountAmount        Decimal    @default(0) @db.Decimal(10, 2)
  discountPercent       Decimal    @default(0) @db.Decimal(5, 2)
  totalAmount           Decimal    @db.Decimal(10, 2)
  paidAmount            Decimal    @default(0) @db.Decimal(10, 2)
  changeAmount          Decimal    @default(0) @db.Decimal(10, 2)
  notes                 String?
  cancelReason          String?
  cancelledAt           DateTime?
  cancelledBy           String?
  saleDate              DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  partnerDiscountAmount Decimal    @default(0) @db.Decimal(10, 2)
  partnerId             String?
  partner               Partner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Origem da venda. Nulo = loja física (toda venda anterior aos canais e toda venda do PDV).
  channelId             String?
  channel               SalesChannel? @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  /// Pedido externo que originou esta venda (um pedido gera no máximo uma venda: `external_orders.saleId` é único).
  externalOrder         ExternalOrder?
  fulfillment           Fulfillment?

  payments  Payment[]
  items SaleItem[]

  discountEventSales DiscountEvent[] @relation("DiscountEvent_saleId")
  employeeAgreementChargeSales EmployeeAgreementCharge[] @relation("EmployeeAgreementCharge_saleId")
  fiscalDocumentSales FiscalDocument[] @relation("FiscalDocument_saleId")
  paymentExceptionSales PaymentException[] @relation("PaymentException_saleId")
  cashRegister CashRegister? @relation("Sale_cashRegisterId", fields: [companyId, cashRegisterId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  tefPaymentSales TefPayment[] @relation("TefPayment_saleId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("Sale_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("Sale_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@unique([companyId, branchId, saleNumber])
  @@index([branchId])
  @@index([branchId, saleDate])
  @@index([cashRegisterId])
  @@index([companyId])
  @@index([companyId, saleDate])
