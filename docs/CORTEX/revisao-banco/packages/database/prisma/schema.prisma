model SupportTicket {
  id                  String    @id @default(uuid())
  /// Número do chamado: sequência global `support_ticket_number_seq` (START 1000, OWNED BY esta coluna; criada na migração 20260928200000).
  /// `autoincrement()` é a forma que o Prisma usa para "default = nextval(sequência)": com `dbgenerated("nextval(...)")` o `migrate diff`
