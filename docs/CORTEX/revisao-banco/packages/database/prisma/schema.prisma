/// companyId/branchId are plain scalars — no FK.
/// Vários códigos de barras por produto (2026-10-14). (companyId, code) é único: um código identifica UM produto na empresa.
/// `products.barcode` segue como código principal (compatibilidade) e é sincronizado pela aplicação.
model ProductBarcode {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String
  /// FK COMPOSTA (companyId, productId) → products(companyId, id): o produto tem que ser da MESMA empresa da linha. Uma FK só em `productId`
  /// não bastava — a checagem de FK do PostgreSQL não passa pela RLS e a policy da linha filha só olha o companyId da própria linha, então a
  /// empresa A conseguia gravar `(companyId = A, productId = produto da B)`. Migração 20261014160000.
  product   Product  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([productId])
  @@index([companyId])
  @@map("product_barcodes")
}

