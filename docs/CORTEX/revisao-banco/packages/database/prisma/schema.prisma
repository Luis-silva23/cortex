model CashMovement {
  id              String            @id @default(uuid())
  cashRegisterId  String
  cashRegister    CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movementType    CashMovementType
  amount          Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  referenceType   String?
  referenceId     String?
  notes           String?
  userId          String
  requestedBy     String?
  authorizedBy    String?
  createdAt       DateTime          @default(now())

  @@index([cashRegisterId])
  @@index([createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("cash_movements")
}

/// `status` has no DB default (unlike every other enum-status column in this
/// schema) — verified against the source DDL, not an omission.
/// Two partial UNIQUE indexes exist only at the database level and cannot be
/// expressed in the Prisma schema (Prisma has no WHERE-filtered @@unique):
/// one open register per (branchId, registerNumber), and one open register
/// per userId — see migration.sql for cash_registers_one_open_per_*.
model CashRegister {
  id              String              @id @default(uuid())
  companyId       String
  branchId        String
  userId          String
  registerNumber  Int
  status          CashRegisterStatus
  openingAmount   Decimal             @db.Decimal(10, 2)
  expectedAmount  Decimal             @default(0) @db.Decimal(10, 2)
  actualAmount    Decimal?            @db.Decimal(10, 2)
  difference      Decimal?            @db.Decimal(10, 2)
  openedAt        DateTime            @default(now())
  closedAt        DateTime?
  closedBy        String?
  notes           String?
  /// NORMAL | FORCED (forçado por gerência/administração, com motivo e as pendências do momento)
  closeType       String              @default("NORMAL")
  forcedReason    String?
  pendingSnapshot Json?
  /// Resumo do fechamento (esperado × informado por forma de pagamento, período, vendas, responsáveis) — 2026-09-28
  closingSummary  Json?
  /// Motivo informado quando o valor informado diverge do esperado
  differenceReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  movements CashMovement[]

  user User @relation("CashRegister_userId", fields: [companyId, userId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  saleCashRegisters Sale[] @relation("Sale_cashRegisterId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("CashRegister_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("CashRegister_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([branchId])
  @@index([branchId, status])
  @@index([openedAt])
  @@index([status])
  @@index([userId])
  @@index([userId, status])
  @@map("cash_registers")
}

model Category {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("Category_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([parentId])
  @@map("categories")
}

/// comboId and productId both reference Product, hence the two named
/// relations to disambiguate which side of the combo each is.
model ComboItem {
  id       String  @id @default(uuid())
  comboId  String
  combo    Product @relation("ComboItemCombo", fields: [comboId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String
  product  Product @relation("ComboItemProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity Decimal @db.Decimal(10, 3)

  @@unique([comboId, productId])
  @@map("combo_items")
}

model CommissionRule {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  serviceType String?
  percentage  Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation("CommissionRule_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId])
  @@index([isActive])
  @@map("commission_rules")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  email     String
  phone     String?
  /// Razão social (`name` é o nome fantasia exibido)
  legalName             String?
  stateRegistration     String?
  municipalRegistration String?
  /// Regime tributário do emitente (CRT da NF-e/NFC-e): SIMPLES_NACIONAL | SIMPLES_NACIONAL_EXCESSO | REGIME_NORMAL | MEI
  taxRegime             String?
  whatsapp              String?
  contactName           String?
  zipCode               String?
  street                String?
  number                String?
  complement            String?
  district              String?
  city                  String?
  state                 String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs           AuditLog[]
  branches            Branch[]
  commercialLead      CommercialLead? @relation("CommercialLead_company")
  installmentPolicies InstallmentPolicy[]
  productBarcodes     ProductBarcode[]
  privacyRequests     PrivacyRequest[]
  productImages       ProductImage[]
  refreshTokens       RefreshToken[]
  licenses            License[]
  partners            Partner[]
  permissions         Permission[]
  roles               Role[]
  users               User[]

  accountsPayablesInCompany AccountsPayable[] @relation("AccountsPayable_company")
  accountsReceivablesInCompany AccountsReceivable[] @relation("AccountsReceivable_company")
  agendaUnavailabilitysInCompany AgendaUnavailability[] @relation("AgendaUnavailability_company")
  agreementCompanysInCompany AgreementCompany[] @relation("AgreementCompany_company")
  appointmentsInCompany Appointment[] @relation("Appointment_company")
  businessCalendarExceptionsInCompany BusinessCalendarException[] @relation("BusinessCalendarException_company")
  businessHourssInCompany BusinessHours[] @relation("BusinessHours_company")
  cashRegistersInCompany CashRegister[] @relation("CashRegister_company")
  categorysInCompany Category[] @relation("Category_company")
  channelApiCredentialsInCompany ChannelApiCredential[] @relation("ChannelApiCredential_company")
  channelEventsInCompany ChannelEvent[] @relation("ChannelEvent_company")
  channelInboundEventsInCompany ChannelInboundEvent[] @relation("ChannelInboundEvent_company")
  channelOutboxsInCompany ChannelOutbox[] @relation("ChannelOutbox_company")
