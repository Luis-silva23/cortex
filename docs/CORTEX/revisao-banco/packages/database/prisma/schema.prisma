/// Ativação/desativação de módulos por empresa (branchId null) ou por
/// filial específica (override). Ausência de linha = módulo HABILITADO
/// (opt-out, não opt-in — uma empresa existente sem nenhuma configuração
/// aqui continua funcionando exatamente como hoje; o oposto quebraria
/// todo tenant já em produção no dia em que esta tabela fosse criada).
/// NUNCA apaga dado de negócio — é só um gate checado no middleware
/// (requireModuleEnabled), nunca uma ação de exclusão/CASCADE; histórico
/// de OS/vendas/estoque etc. de um módulo desativado continua intacto e
/// consultável, só a escrita/operação fica bloqueada enquanto desativado.
/// Duas UNIQUE parciais reais no banco (Prisma não expressa `@@unique`
/// com WHERE) — mesmo padrão de CashRegister/Inventory: uma linha
/// company-wide (branchId NULL) por empresa+módulo, e uma linha por
/// filial+módulo quando houver override — ver migration
/// `add_company_module_settings`.
model CompanyModuleSetting {
  id             String       @id @default(uuid())
  companyId      String
  branchId       String?
  module         SystemModule
  isEnabled      Boolean      @default(true)
  disabledBy     String?
  disabledAt     DateTime?
  disabledReason String?
  reenabledBy    String?
  reenabledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company Company @relation("CompanyModuleSetting_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("CompanyModuleSetting_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId])
  @@index([companyId, branchId])
  @@map("company_module_settings")
}

/// Configuração de pagamento por empresa (branchId null) com override por filial, campo a campo. Ausência de valor =
/// padrão (controle de cédulas desligado, provedores MANUAL). Unicidade parcial no banco, como CompanyModuleSetting.
model PaymentSetting {
  id                      String   @id @default(uuid())
  companyId               String
  branchId                String?
  /// Campos nulos herdam (filial → empresa → padrão).
  cashDenominationControl Boolean?
  /// Provedor registrado no servidor (payment-adapters): MANUAL = maquininha sem integração / PIX conciliado à mão.
  cardProvider            String?
  pixProvider             String?
  /// Identificador do terminal/POS no provedor (não é segredo; credenciais nunca ficam nesta tabela).
  terminalId              String?
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation("PaymentSetting_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("PaymentSetting_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId])
  @@map("payment_settings")
}

/// Telemetria real enviada pelo equipamento (PDV Electron): host (CPU/RAM/disco) e rede até a API. Empresa, filial e
/// equipamento vêm da sessão de equipamento do usuário autenticado, nunca do corpo. Retenção: 30 dias (agendador).
model DeviceTelemetry {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String?
  deviceId      String
  userId        String
  collectedAt   DateTime
  receivedAt    DateTime @default(now())
  cpuLoadPct    Float?
  memUsedPct    Float?
  diskUsedPct   Float?
  apiRttMs      Int?
  packetLossPct Float?
  /// versão do app CÓRTEX (package.json do PDV)
  appVersion    String?
  /// runtime do equipamento (ex.: "electron 28.3.3 · node 18.18.2 · chrome 120")
  runtimeVersion String?
  uptimeSec     Int?

  @@unique([deviceId, collectedAt])
  @@index([companyId, branchId, collectedAt])
  @@map("device_telemetry")
}

/// Histórico de saúde: um incidente por componente enquanto o estado não é NORMAL (endedAt nulo = em aberto).
model HealthIncident {
  id        String    @id @default(uuid())
  companyId String
  branchId  String?
  component String
  status    String
  detail    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([companyId, branchId, startedAt])
  @@index([endedAt])
  @@map("health_incidents")
}

/// Limite de uma métrica do monitoramento. Escopo: global (empresa e filial nulas), empresa ou filial; o mais específico
/// vence. Único por escopo+métrica (índice `monitoring_thresholds_scope_metric`, na migração). Só SUPER_ADMIN grava (RLS).
model MonitoringThreshold {
  id        String   @id @default(uuid())
  companyId String?
  branchId  String?
  metric    String
  attention Float
  critical  Float
  updatedBy String
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@map("monitoring_thresholds")
}

/// Lote de importação (produtos, clientes, estoque): resultado de cada linha em `results`
/// ([{ row, key, action: CREATED|UPDATED|UNCHANGED|ERROR, id?, error? }]). Movimentos de estoque da importação
/// apontam para o lote (referenceType 'ImportBatch').
model ImportBatch {
  id            String    @id @default(uuid())
  companyId     String
  branchId      String?
  type          String
  userId        String
  fileName      String?
  totalRows     Int
  importedRows  Int       @default(0)
  unchangedRows Int       @default(0)
  failedRows    Int       @default(0)
  results       Json      @default("[]")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  user User @relation("ImportBatch_userId", fields: [companyId, userId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  company Company @relation("ImportBatch_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("ImportBatch_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([companyId, startedAt])
  @@map("import_batches")
}

/// Histórico imutável das alterações de limites (quem, quando, de/para, motivo).
model MonitoringThresholdChange {
  id           String   @id @default(uuid())
  companyId    String?
  branchId     String?
  metric       String
  oldAttention Float?
  oldCritical  Float?
  newAttention Float?
  newCritical  Float?
  reason       String
  changedBy    String
  changedAt    DateTime @default(now())

  @@index([companyId, changedAt])
  @@map("monitoring_threshold_changes")
}

/// Alerta do monitoramento: condição fora do limite num alvo (central, filial ou equipamento). No máximo um aberto por
/// tipo+alvo (`monitoring_alerts_one_open`); reincidência logo após encerrar reabre o mesmo (occurrences) em vez de criar outro.
model MonitoringAlert {
  id          String    @id @default(uuid())
  source      String
  companyId   String?
  branchId    String?
  deviceId    String?
  type        String
  metric      String
  severity    String
  value       Float?
  threshold   Float?
  detail      String?
  occurrences Int       @default(1)
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  /// Tratamento humano enquanto aberto: OPEN | ACKNOWLEDGED | IN_PROGRESS. "Resolvido" é `endedAt` preenchido (o estado exposto é calculado).
  handling       String    @default("OPEN")
  assignedTo     String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  /// Quem encerrou à mão (nulo = encerrado sozinho porque a condição voltou ao normal) e a justificativa.
  resolvedBy     String?
  resolutionNote String?

  @@index([companyId, startedAt])
  @@index([endedAt])
  @@map("monitoring_alerts")
}

/// Histórico de tratamento do alerta (quem, quando, o quê). Imutável: sem UPDATE; DELETE só com o expurgo sinalizado. Só SUPER_ADMIN lê e grava.
model MonitoringAlertEvent {
  id        String   @id @default(uuid())
  alertId   String
  companyId String?
  /// OPENED | REOPENED | SEVERITY_CHANGED | ACKNOWLEDGED | ASSIGNED | IN_PROGRESS | RESOLVED | AUTO_RESOLVED | NOTE | NOTIFIED | NOTIFICATION_SUPPRESSED
  kind      String
  actorId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("monitoring_alert_events")
}

/// Amostra periódica da saúde de um serviço da plataforma (disponibilidade, latência, uso do servidor). Telemetria com retenção
/// (MONITORING_SAMPLE_RETENTION_DAYS); coletada pelo job `evaluate-health` no intervalo MONITORING_SAMPLE_MINUTES. Só SUPER_ADMIN.
model ServiceHealthSample {
  id        String   @id @default(uuid())
  sampledAt DateTime @default(now())
  /// API | DATABASE | REDIS | QUEUES | HOST_CPU | HOST_MEMORY | HOST_DISK | BACKUP
  service   String
  /// NORMAL | ATTENTION | CRITICAL | OFFLINE (mesma escala do monitoramento por filial)
  status    String
  latencyMs Float?
  valuePct  Float?
  detail    String?

  @@index([service, sampledAt])
  @@index([sampledAt])
  @@map("service_health_samples")
}

/// Funil comercial da PLATAFORMA (interessado → ... → cliente ativo): uma linha por oportunidade. `companyId` liga a oportunidade à empresa
/// criada na implantação. Só SUPER_ADMIN. Nenhum dado de cliente final: só o nome comercial e uma anotação de contato.
model CommercialLead {
  id             String   @id @default(uuid())
  name           String
  contact        String?
  source         String?
  /// INTERESTED | DEMO | PROPOSAL | ONBOARDING | ACTIVE | SUSPENDED | CANCELLED
  stage          String   @default("INTERESTED")
  stageEnteredAt DateTime @default(now())
  companyId      String?  @unique
  closedReason   String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company?              @relation("CommercialLead_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events  CommercialLeadEvent[]

  @@index([stage, stageEnteredAt])
  @@map("commercial_leads")
}

/// Cada mudança de etapa do funil (de onde, para onde, quem, quando): base do tempo em cada etapa e da conversão. Imutável.
model CommercialLeadEvent {
  id        String   @id @default(uuid())
  leadId    String
  fromStage String?
  toStage   String
  actorId   String
  note      String?
  createdAt DateTime @default(now())

  lead CommercialLead @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leadId, createdAt])
  @@index([toStage, createdAt])
  @@map("commercial_lead_events")
}

/// Entrega a um serviço externo (e-mail de alerta, evento de erro): base da deduplicação, dos limites de envio e do painel de consumo.
/// Nunca guarda o conteúdo da mensagem nem segredo; `error` é a mensagem já mascarada. Telemetria com retenção. Só SUPER_ADMIN.
model ExternalDelivery {
  id        String   @id @default(uuid())
  /// EMAIL | SENTRY
  channel   String
  /// SENT | FAILED | SUPPRESSED
  status    String
  dedupeKey String?
  alertId   String?
  error     String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@index([dedupeKey, createdAt])
  @@map("external_deliveries")
}

/// Ajustes de runtime do monitoramento (ligar/desligar notificações e coleta não crítica, limites). O ambiente continua sendo o teto: o ajuste
/// só restringe. Só SUPER_ADMIN lê e grava.
model MonitoringSetting {
  key       String   @id
  value     Json
  updatedBy String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("monitoring_settings")
}

model Customer {
  id           String       @id @default(uuid())
  companyId    String
  customerType CustomerType @default(INDIVIDUAL)
  name         String
  document     String?
  email        String?
  phone        String?
  mobile       String?
  birthDate    DateTime?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  whatsapp         String?
  preferredContact ContactChannel?
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  /// Preenchido quando o cadastro foi anonimizado a pedido do titular (decisão 120). Irreversível: os dados originais não são guardados.
  anonymizedAt DateTime?

  motorcycles   Motorcycle[]
  quotes        Quote[]
  sales         Sale[]
  serviceOrders ServiceOrder[]
  revisions     Revision[]
  followUps     FollowUp[]
  appointments  Appointment[]

  accountsReceivableCustomers AccountsReceivable[] @relation("AccountsReceivable_customerId")
  employeeAgreementCustomers EmployeeAgreement[] @relation("EmployeeAgreement_customerId")
  serviceOrderWarrantyCustomers ServiceOrderWarranty[] @relation("ServiceOrderWarranty_customerId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("Customer_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@unique([companyId, document])
  @@index([companyId])
  @@index([document])
  @@index([email])
  @@index([isActive])
  @@index([mobile])
  @@index([phone])
  @@map("customers")
