  checklist   VehicleEntryChecklist @relation(fields: [checklistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itemName    String
  status      ChecklistItemStatus  @default(NOT_CHECKED)
  description String?
  photoUrl    String?

  @@index([checklistId])
  @@map("vehicle_entry_checklist_items")
}

/// companyId/checkedBy are plain scalars — no FK. serviceOrderId is unique,
/// making this a 1:1 with ServiceOrder.
model VehicleEntryChecklist {
