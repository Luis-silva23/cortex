  companyId      String
  serviceOrderId String       @unique
  serviceOrder   ServiceOrder @relation(fields: [companyId, serviceOrderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  motorcycleId   String
  motorcycle     Motorcycle   @relation(fields: [companyId, motorcycleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  checkedBy      String
  checkedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  items VehicleEntryChecklistItem[]

  /// Exigida pelo Prisma na relação 1:1 pela FK composta; redundante com o @unique da coluna (migração 20261014180000_composite_company_fks).
  company Company @relation("VehicleEntryChecklist_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, serviceOrderId])
  @@index([companyId])
  @@index([motorcycleId])
  @@map("vehicle_entry_checklists")
}

/// companyId/branchId/serviceOrderId/recordedBy plain scalars (mesmo padrão
/// do resto do schema — isolamento via RLS, não FK). Imutável por design:
/// histórico do que já foi feito num veículo — o service nunca expõe
/// update/delete, só create. `nextDueDate`/`nextDueKilometer` são
/// calculados no momento da criação (performedAt + intervalMonths, e
/// kilometerAtService + intervalKilometers quando informado) e persistidos
/// — não recalculados em leitura — para que o histórico continue
/// reproduzindo exatamente o que foi comunicado ao cliente na época, mesmo
/// se a política de intervalo padrão da empresa mudar depois.
model Revision {
  id                 String        @id @default(uuid())
  companyId          String
  branchId           String?
  customerId         String
  customer           Customer      @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  motorcycleId       String
  motorcycle         Motorcycle    @relation(fields: [companyId, motorcycleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  serviceOrderId     String?
  serviceOrder       ServiceOrder? @relation(fields: [companyId, serviceOrderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  performedAt        DateTime
  kilometerAtService Decimal       @db.Decimal(10, 1)
  servicesPerformed  String
  partsReplaced      String?
  /// recomendação ao cliente até a próxima revisão
  recommendations    String?
  notes              String?
  intervalMonths     Int           @default(3)
  intervalKilometers Int?
  nextDueDate        DateTime
  nextDueKilometer   Decimal?      @db.Decimal(10, 1)
  recordedBy         String
  createdAt          DateTime      @default(now())

  followUps FollowUp[]

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("Revision_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("Revision_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([branchId])
  @@index([customerId])
  @@index([motorcycleId])
  @@index([nextDueDate])
  @@map("revisions")
}

/// companyId/branchId/createdBy plain scalars. `status` é exatamente os 3
/// baldes do dashboard de pós-venda — de propósito NÃO existe um status
/// "Aguardando contato": tentativas de contato são eventos em
/// FollowUpEvent (histórico), nunca um status próprio do FollowUp.
model FollowUp {
  id           String         @id @default(uuid())
  companyId    String
  branchId     String?
  revisionId   String?
  revision     Revision?      @relation(fields: [companyId, revisionId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  customerId   String
  customer     Customer       @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  motorcycleId String
  motorcycle   Motorcycle     @relation(fields: [companyId, motorcycleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  dueDate      DateTime
  status       FollowUpStatus @default(PENDING)
  notes        String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  events      FollowUpEvent[]
  appointment Appointment?

  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("FollowUp_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("FollowUp_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([branchId])
  @@index([customerId])
  @@index([motorcycleId])
  @@index([status])
  @@index([dueDate])
  @@map("follow_ups")
}

/// Sem companyId próprio — isolamento via followUpId, mesmo padrão de
/// ServiceOrderStatusHistory (RLS junta com a tabela pai, ver
/// migration.sql). Imutável: histórico de contato e decisões do cliente,
/// nunca atualizado ou apagado.
model FollowUpEvent {
  id          String            @id @default(uuid())
  followUpId  String
  followUp    FollowUp          @relation(fields: [followUpId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventType   FollowUpEventType
  channel     ContactChannel?
  message     String?
  performedBy String
  createdAt   DateTime          @default(now())

  @@index([followUpId])
  @@index([createdAt])
  @@map("follow_up_events")
}

/// companyId/branchId/proposedBy plain scalars. `customerConfirmed` +
/// `confirmedAt` existem separados de `status` de propósito: a equipe pode
/// PROPOR um horário (status=PROPOSED) sem que isso signifique confirmação
/// — só version um evento CONFIRMED (via customer) muda
/// `customerConfirmed` para true. Nunca gravar confirmação sem essa
/// distinção — é a regra central deste domínio.
model Appointment {
  id                String            @id @default(uuid())
  companyId         String
  branchId          String?
  followUpId        String?           @unique
  followUp          FollowUp?         @relation(fields: [companyId, followUpId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  customerId        String
  customer          Customer          @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  motorcycleId      String?
  motorcycle        Motorcycle?       @relation(fields: [companyId, motorcycleId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  scheduledAt       DateTime
  status            AppointmentStatus @default(PROPOSED)
  proposedBy        String
  customerConfirmed Boolean           @default(false)
  confirmedAt       DateTime?
  /// canal em que o cliente/responsável confirmou (obrigatório ao confirmar desde 2026-09-26)
  confirmationChannel ContactChannel?
  /// quem confirmou: o cliente ou o responsável pelo veículo (não o funcionário que registrou)
  confirmedByName   String?
