  agreementCompany AgreementCompany? @relation("Payment_agreementCompanyId", fields: [companyId, agreementCompanyId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  employeeAgreement EmployeeAgreement? @relation("Payment_employeeAgreementId", fields: [companyId, employeeAgreementId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  tefPaymentPayments TefPayment[] @relation("TefPayment_paymentId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("Payment_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([paidAt])
  @@index([paymentMethod])
  @@index([saleId])
  @@index([saleId, status])
  @@index([status])
  @@index([employeeAgreementId])
  @@index([agreementCompanyId])
