/// ACHADO DE AUDITORIA DE INTEGRAÇÃO: nada impedia dois inventários
/// IN_PROGRESS simultâneos na mesma filial — cada um capturaria um
/// `systemQuantity` desatualizado e, no fechamento, o segundo sobrescreveria
/// silenciosamente a correção do primeiro. Mesmo padrão já usado em
/// CashRegister (ver comentário lá): uma UNIQUE parcial no banco, que o
/// Prisma Schema não consegue expressar (sem suporte a `@@unique` com
/// WHERE) — ver migration `add_inventory_one_in_progress_per_branch`.
model Inventory {
  id              String          @id @default(uuid())
  companyId       String
  branchId        String
  inventoryNumber Int
  status          InventoryStatus @default(DRAFT)
  startedBy       String
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  counts InventoryCount[]

  company Company @relation("Inventory_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch @relation("Inventory_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([branchId, inventoryNumber])
  @@index([branchId])
  @@index([companyId])
  @@index([startedAt])
  @@index([status])
  @@map("inventories")
}

model InventoryCount {
  id              String    @id @default(uuid())
  inventoryId     String
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
