/// companyId/branchId/supplierId are plain scalars — no FK in the database,
/// isolation is via RLS (rls_company_match) only.
///
/// A partial UNIQUE index exists only at the database level and cannot be
/// expressed in the Prisma schema (no WHERE-filtered @@unique): at most one
/// row with referenceType='Reversal' per referenceId — see migration
/// `add_accounts_reversal_unique_reference`. Backstops
/// FinancialService.reversePayable's application-level guard (mesmo padrão
/// já usado em CashRegister/Inventory).
model AccountsPayable {
  id            String        @id @default(uuid())
  companyId     String
  branchId      String?
  supplierId    String?
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        AccountStatus @default(PENDING)
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier Supplier? @relation("AccountsPayable_supplierId", fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  company Company @relation("AccountsPayable_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("AccountsPayable_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@index([branchId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([dueDate])
  @@index([status])
  @@index([supplierId])
  @@map("accounts_payable")
}

/// companyId/branchId/customerId are plain scalars — no FK, RLS-enforced.
///
/// Same partial UNIQUE index note as AccountsPayable — see migration
/// `add_accounts_reversal_unique_reference` (at most one
/// referenceType='Reversal' row per referenceId), backstopping
/// FinancialService.reverseReceivable's application-level guard.
model AccountsReceivable {
  id            String        @id @default(uuid())
  companyId     String
  branchId      String?
  customerId    String?
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        AccountStatus @default(PENDING)
  referenceType String?
  referenceId   String?
  /// Conta de convênio: empresa conveniada ou convênio de funcionário
  agreementCompanyId  String?
  employeeAgreementId String?
  collectionAttempts  CollectionAttempt[]
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agreementCompany AgreementCompany? @relation("AccountsReceivable_agreementCompanyId", fields: [companyId, agreementCompanyId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  customer Customer? @relation("AccountsReceivable_customerId", fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  employeeAgreement EmployeeAgreement? @relation("AccountsReceivable_employeeAgreementId", fields: [companyId, employeeAgreementId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  company Company @relation("AccountsReceivable_company", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation("AccountsReceivable_branch", fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId, id])
  @@index([branchId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
  @@index([agreementCompanyId])
  @@index([employeeAgreementId])
  @@map("accounts_receivable")
}

model Activation {
  id             String           @id @default(uuid())
  licenseId      String
  license        License          @relation(fields: [licenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deviceId       String
  device         Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activationCode String           @unique
  status         ActivationStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  activatedAt    DateTime         @default(now())
  expiresAt      DateTime?
  ipAddress      String?

  @@index([deviceId])
  @@index([licenseId])
  @@index([status])
  @@index([userId])
  @@map("activations")
}

model AuditLog {
  id        String      @id @default(uuid())
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  action    AuditAction
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([companyId, createdAt])
  @@index([companyId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, action])
  @@index([userId])
  @@map("audit_logs")
}

model Branch {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name           String
  document       String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  phone          String?
  stateRegistration String?
  email             String?
  whatsapp          String?
  street            String?
  number            String?
  complement        String?
  district          String?
  isActive       Boolean  @default(true)
  isHeadquarter  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]

  transferFromBranchs Transfer[] @relation("Transfer_fromBranchId")
  transferToBranchs Transfer[] @relation("Transfer_toBranchId")
  /// Alvo das FKs compostas (companyId, <filho>Id) → este modelo; redundante com a PK (migração 20261014180000_composite_company_fks).
  accountsPayablesInBranch AccountsPayable[] @relation("AccountsPayable_branch")
  accountsReceivablesInBranch AccountsReceivable[] @relation("AccountsReceivable_branch")
  agendaUnavailabilitysInBranch AgendaUnavailability[] @relation("AgendaUnavailability_branch")
  agreementCompanysInBranch AgreementCompany[] @relation("AgreementCompany_branch")
  appointmentsInBranch Appointment[] @relation("Appointment_branch")
  businessCalendarExceptionsInBranch BusinessCalendarException[] @relation("BusinessCalendarException_branch")
  businessHourssInBranch BusinessHours[] @relation("BusinessHours_branch")
  cashRegistersInBranch CashRegister[] @relation("CashRegister_branch")
  channelApiCredentialsInBranch ChannelApiCredential[] @relation("ChannelApiCredential_branch")
  channelEventsInBranch ChannelEvent[] @relation("ChannelEvent_branch")
  channelInboundEventsInBranch ChannelInboundEvent[] @relation("ChannelInboundEvent_branch")
  channelOutboxsInBranch ChannelOutbox[] @relation("ChannelOutbox_branch")
  channelProductLinksInBranch ChannelProductLink[] @relation("ChannelProductLink_branch")
  collectionAttemptsInBranch CollectionAttempt[] @relation("CollectionAttempt_branch")
  companyModuleSettingsInBranch CompanyModuleSetting[] @relation("CompanyModuleSetting_branch")
  damageRecordsInBranch DamageRecord[] @relation("DamageRecord_branch")
  deviceSessionsInBranch DeviceSession[] @relation("DeviceSession_branch")
  discountEventsInBranch DiscountEvent[] @relation("DiscountEvent_branch")
  employeeAgreementChargesInBranch EmployeeAgreementCharge[] @relation("EmployeeAgreementCharge_branch")
  employeeAgreementsInBranch EmployeeAgreement[] @relation("EmployeeAgreement_branch")
  employeePayrollDeductionsInBranch EmployeePayrollDeduction[] @relation("EmployeePayrollDeduction_branch")
  externalOrderItemsInBranch ExternalOrderItem[] @relation("ExternalOrderItem_branch")
  externalOrdersInBranch ExternalOrder[] @relation("ExternalOrder_branch")
  externalPaymentsInBranch ExternalPayment[] @relation("ExternalPayment_branch")
  fiscalConfigsInBranch FiscalConfig[] @relation("FiscalConfig_branch")
  fiscalDocumentsInBranch FiscalDocument[] @relation("FiscalDocument_branch")
  followUpsInBranch FollowUp[] @relation("FollowUp_branch")
  fulfillmentsInBranch Fulfillment[] @relation("Fulfillment_branch")
  importBatchsInBranch ImportBatch[] @relation("ImportBatch_branch")
  installmentPolicysInBranch InstallmentPolicy[] @relation("InstallmentPolicy_branch")
  inventorysInBranch Inventory[] @relation("Inventory_branch")
  partnersInBranch Partner[] @relation("Partner_branch")
  paymentExceptionsInBranch PaymentException[] @relation("PaymentException_branch")
  paymentSettingsInBranch PaymentSetting[] @relation("PaymentSetting_branch")
  policyChangesInBranch PolicyChange[] @relation("PolicyChange_branch")
  policySettingsInBranch PolicySetting[] @relation("PolicySetting_branch")
  productsInBranch Product[] @relation("Product_branch")
  purchaseOrdersInBranch PurchaseOrder[] @relation("PurchaseOrder_branch")
  quoteEventsInBranch QuoteEvent[] @relation("QuoteEvent_branch")
  quotesInBranch Quote[] @relation("Quote_branch")
  revisionsInBranch Revision[] @relation("Revision_branch")
  salesInBranch Sale[] @relation("Sale_branch")
  salesChannelsInBranch SalesChannel[] @relation("SalesChannel_branch")
  serviceOrderWarrantysInBranch ServiceOrderWarranty[] @relation("ServiceOrderWarranty_branch")
  serviceOrdersInBranch ServiceOrder[] @relation("ServiceOrder_branch")
  stockMovementsInBranch StockMovement[] @relation("StockMovement_branch")
  stockReservationsInBranch StockReservation[] @relation("StockReservation_branch")
  supplierReturnEventsInBranch SupplierReturnEvent[] @relation("SupplierReturnEvent_branch")
  supplierReturnItemsInBranch SupplierReturnItem[] @relation("SupplierReturnItem_branch")
  supplierReturnsInBranch SupplierReturn[] @relation("SupplierReturn_branch")
  supportTicketAttachmentsInBranch SupportTicketAttachment[] @relation("SupportTicketAttachment_branch")
  supportTicketEventsInBranch SupportTicketEvent[] @relation("SupportTicketEvent_branch")
  supportTicketMessagesInBranch SupportTicketMessage[] @relation("SupportTicketMessage_branch")
  supportTicketsInBranch SupportTicket[] @relation("SupportTicket_branch")
  warrantyClaimsInBranch WarrantyClaim[] @relation("WarrantyClaim_branch")
  userBranchesInBranch UserBranch[] @relation("UserBranch_branch")
  @@unique([companyId, id])
  @@map("branches")
